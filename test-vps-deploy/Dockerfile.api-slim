# Imagen mínima para servir la API (sin docling/torch). Adecuada para VPS con poco disco.
FROM python:3.13-slim

WORKDIR /code

RUN apt-get update \
    && apt-get install -y --no-install-recommends libpq5 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    "fastapi>=0.135.3" \
    "uvicorn[standard]>=0.34.0" \
    "sqlalchemy>=2.0.49" \
    "psycopg2-binary>=2.9.11" \
    "pydantic-settings>=2.7.0" \
    "fastapi-cache2[redis]>=0.2.2" \
    "pgvector>=0.3.6" \
    "redis>=4.2.0,<5.0.0" \
    "jinja2>=3.1.0"

COPY vinculante /code/vinculante

ENV PYTHONPATH=/code

EXPOSE 8000

CMD ["uvicorn", "vinculante.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8000"]
